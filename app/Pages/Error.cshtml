@page
@model ExpenseManagement.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-wrapper">
    <div style="max-width: 560px; margin: 48px auto; text-align:center;">
        <div style="font-size: 4rem; margin-bottom: 16px;">⚠️</div>
        <h1 style="font-size:1.8rem; margin-bottom:8px;">Something went wrong</h1>
        <p style="color:#64748b; margin-bottom:24px;">
            An unexpected error occurred. Please try again or contact support.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-info" style="text-align:left; font-family:monospace; font-size:0.8rem;">
                <strong>Request ID:</strong> @Model.RequestId
            </div>
        }

        <div style="margin-top:24px; display:flex; gap:12px; justify-content:center;">
            <a href="/" class="btn btn-primary">Go to Dashboard</a>
            <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
        </div>
    </div>
</div>
